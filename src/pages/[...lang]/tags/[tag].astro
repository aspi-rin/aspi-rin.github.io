---
import PostList from '@/components/PostList.astro'
import TagList from '@/components/TagList.astro'
import { allLocales } from '@/config'
import { getLangFromPath, getLangRouteParam } from '@/i18n/lang'
import { taxonomySlug } from '@/utils/taxonomy'
import Layout from '@/layouts/Layout.astro'
import { getAllTags, getPostsByTag } from '@/utils/content'

export async function getStaticPaths() {
  const paths = await Promise.all(allLocales.map(async (lang) => {
    const langTags = await getAllTags(lang)
    return langTags.map(tag => ({
      params: { lang: getLangRouteParam(lang), tag: taxonomySlug(tag) },
      props: { tag },
    }))
  }))
  return paths.flat()
}

interface Props {
  tag: string
}

const { tag } = Astro.props
const currentLang = getLangFromPath(Astro.url.pathname)
const posts = await getPostsByTag(tag, currentLang)
const allTags = await getAllTags(currentLang)
const supportedLangs = (await Promise.all(allLocales.map(async (lang) => {
  const tags = await getAllTags(lang)
  return tags.some(value => taxonomySlug(value) === taxonomySlug(tag)) ? lang : null
}))).filter(lang => lang !== null)
---

<Layout supportedLangs={supportedLangs}>
  <!-- Decorative Line -->
  <div class="uno-decorative-line" />
  <!-- Tag List -->
  <TagList
    tags={allTags}
    currentTag={tag}
    lang={currentLang}
  />

  <!-- Posts List -->
  <PostList
    posts={posts}
    lang={currentLang}
  />
</Layout>
