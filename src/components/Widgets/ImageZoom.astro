---
import type { Language } from '@/i18n/config'
import { parse } from 'node-html-parser'
import { blogLabels } from '@/i18n/blog'

interface Props {
  lang: Language
}

const { gallery: labels } = blogLabels(Astro.props.lang)
const body = await Astro.slots.render('default')
let content = body

if (body?.includes('image-trigger')) {
  const document = parse(body)
  for (const link of document.querySelectorAll('a.image-trigger')) {
    const thumbnail = link.querySelector('img')
    const src = thumbnail?.getAttribute('src')
    if (!src || !URL.canParse(src, Astro.url))
      continue
    const { protocol } = new URL(src, Astro.url)
    if (protocol !== 'http:' && protocol !== 'https:')
      continue
    link.setAttribute('href', src)
    if (!thumbnail?.getAttribute('alt'))
      link.setAttribute('aria-label', thumbnail?.getAttribute('title') || labels.image)
  }
  content = document.toString()
}
---

<Fragment set:html={content} />

<template id="image-layout-controls">
  <div class="image-layout-controls" role="group" aria-label={labels.layout}>
    <button type="button" data-layout="justified" aria-label={labels.justified} title={labels.justified} aria-pressed="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="3" y="4" width="18" height="5" rx="1" />
        <rect x="3" y="12" width="7.5" height="8" rx="1" />
        <rect x="13.5" y="12" width="7.5" height="8" rx="1" />
      </svg>
    </button>
    <button type="button" data-layout="masonry" aria-label={labels.masonry} title={labels.masonry} aria-pressed="false">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="3" y="3" width="7.5" height="7" rx="1" />
        <rect x="3" y="13" width="7.5" height="8" rx="1" />
        <rect x="13.5" y="3" width="7.5" height="10" rx="1" />
        <rect x="13.5" y="16" width="7.5" height="5" rx="1" />
      </svg>
    </button>
    <button type="button" data-layout="grid" aria-label={labels.grid} title={labels.grid} aria-pressed="false">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="3" y="3" width="7.5" height="7.5" rx="1" />
        <rect x="13.5" y="3" width="7.5" height="7.5" rx="1" />
        <rect x="3" y="13.5" width="7.5" height="7.5" rx="1" />
        <rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1" />
      </svg>
    </button>
  </div>
</template>

<dialog id="image-viewer" class="image-viewer" aria-label={labels.image}>
  <button class="image-viewer-close" type="button" data-close aria-label={labels.close} autofocus>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="m6 6 12 12M18 6 6 18" />
    </svg>
  </button>
  <button class="image-viewer-zoom" type="button" data-zoom aria-label={labels.actualSize} title={labels.actualSize} aria-pressed="false" disabled>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="10.5" cy="10.5" r="5.5" />
      <path d="m14.5 14.5 4.5 4.5M8 10.5h5" />
      <path class="image-viewer-zoom-plus" d="M10.5 8v5" />
    </svg>
  </button>
  <button class="image-viewer-previous" type="button" data-previous aria-label={labels.previous}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="m15 6-6 6 6 6" />
    </svg>
  </button>
  <div class="image-viewer-viewport" role="region" aria-label={labels.image} tabindex="-1">
    <figure>
      <img alt="" draggable="false" />
      <figcaption hidden></figcaption>
    </figure>
  </div>
  <button class="image-viewer-next" type="button" data-next aria-label={labels.next}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="m9 6 6 6-6 6" />
    </svg>
  </button>
</dialog>

<script>
import { setupImageGalleries } from '@/scripts/image-gallery'

function setupImages() {
  const dialog = document.querySelector<HTMLDialogElement>('#image-viewer')
  if (!dialog || typeof dialog.showModal !== 'function')
    return
  const image = dialog.querySelector('img')!
  const caption = dialog.querySelector('figcaption')!
  const viewport = dialog.querySelector<HTMLElement>('.image-viewer-viewport')!
  const zoom = dialog.querySelector<HTMLButtonElement>('[data-zoom]')!
  const previous = dialog.querySelector<HTMLButtonElement>('[data-previous]')!
  const next = dialog.querySelector<HTMLButtonElement>('[data-next]')!
  const panSteps = new Map<string, [number, number]>([
    ['ArrowLeft', [-48, 0]],
    ['ArrowRight', [48, 0]],
    ['ArrowUp', [0, -48]],
    ['ArrowDown', [0, 48]],
  ])
  let images: HTMLImageElement[] = []
  let index = 0
  let dragStart: { x: number, y: number, left: number, top: number } | undefined

  function setActualSize(enabled: boolean) {
    viewport.toggleAttribute('data-actual-size', enabled)
    viewport.tabIndex = enabled ? 0 : -1
    zoom.setAttribute('aria-pressed', String(enabled))
    if (enabled) {
      viewport.scrollLeft = (image.offsetWidth - viewport.clientWidth) / 2
      viewport.scrollTop = (image.offsetHeight - viewport.clientHeight) / 2
    }
    else {
      viewport.scrollTo(0, 0)
    }
  }

  function updateZoomAvailability() {
    zoom.disabled = !image.complete || !image.naturalWidth
  }

  function showImage(targetIndex: number) {
    if (targetIndex < 0 || targetIndex >= images.length)
      return
    setActualSize(false)
    index = targetIndex
    const source = images[index]
    image.src = source.closest<HTMLAnchorElement>('a.image-trigger[href]')?.href || source.currentSrc || source.src
    updateZoomAvailability()
    image.alt = source.alt
    const description = source.closest('figure')?.querySelector('figcaption')?.textContent ?? ''
    caption.textContent = description
    caption.hidden = !description
    previous.hidden = next.hidden = images.length < 2
    previous.disabled = index === 0
    next.disabled = index === images.length - 1
  }

  dialog.addEventListener('click', (event) => {
    if (event.target === dialog || (event.target instanceof Element && event.target.closest('[data-close]'))) {
      dialog.close()
    }
  })
  dialog.addEventListener('keydown', (event) => {
    if (event.target === viewport && viewport.hasAttribute('data-actual-size')) {
      const step = panSteps.get(event.key)
      if (step) {
        event.preventDefault()
        viewport.scrollBy(...step)
      }
      return
    }
    if (event.key === 'ArrowLeft')
      showImage(index - 1)
    if (event.key === 'ArrowRight')
      showImage(index + 1)
  })
  image.addEventListener('load', updateZoomAvailability)
  image.addEventListener('error', updateZoomAvailability)
  zoom.addEventListener('click', () => setActualSize(!viewport.hasAttribute('data-actual-size')))

  image.addEventListener('pointerdown', (event) => {
    if (event.pointerType !== 'mouse' || event.button !== 0 || !viewport.hasAttribute('data-actual-size'))
      return
    image.setPointerCapture(event.pointerId)
    dragStart = {
      x: event.clientX,
      y: event.clientY,
      left: viewport.scrollLeft,
      top: viewport.scrollTop,
    }
  })
  image.addEventListener('pointermove', (event) => {
    if (!dragStart || !image.hasPointerCapture(event.pointerId))
      return
    viewport.scrollLeft = dragStart.left + dragStart.x - event.clientX
    viewport.scrollTop = dragStart.top + dragStart.y - event.clientY
  })
  image.addEventListener('lostpointercapture', () => {
    dragStart = undefined
  })

  previous.addEventListener('click', () => showImage(index - 1))
  next.addEventListener('click', () => showImage(index + 1))

  const main = document.querySelector('main')
  main?.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || event.defaultPrevented
      || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
      return
    }
    const trigger = event.target.closest('.image-trigger[href]')
    if (!trigger && event.target.closest('a'))
      return
    const source = trigger?.querySelector('img') ?? event.target
    if (!(source instanceof HTMLImageElement) || !source.closest('.heti'))
      return
    if (!trigger && (!source.complete || source.width < 100 || source.height < 100))
      return

    const group = source.closest('.image-gallery-items')
    images = group ? [...group.querySelectorAll('img')] : [source]
    showImage(images.indexOf(source))
    dialog.showModal()
    if (trigger)
      event.preventDefault()
  })
}

let stopGalleries: (() => void) | undefined

function setupPageImages() {
  stopGalleries?.()
  setupImages()
  stopGalleries = setupImageGalleries()
}

setupPageImages()
document.addEventListener('astro:after-swap', setupPageImages)
</script>
