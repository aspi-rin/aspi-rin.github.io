    "astro": "^7.4.13",
    "astro-compress": "^2.4.3",
    "astro-og-canvas": "^0.13.3",
    "canvaskit-wasm": "^0.42.0",
    "feed": "^5.2.0",
    "katex": "^0.19.1",
